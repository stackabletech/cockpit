{
  "name": "@stackable/stackable-cockpit",
  "private": true,
  "version": "0.0.1",
  "license": "OSL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "prepare": "svelte-kit sync || echo '' && npm run generate:antlr",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write --ignore-path .prettierignore .",
    "lint": "prettier --check --ignore-path .prettierignore . && eslint . && npm run check && npm run knip && npm run test:arch",
    "lint:fix": "prettier --write --ignore-path .prettierignore . && eslint . --fix && npm run check && npm run knip && npm run test:arch",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "test:unit": "vitest run",
    "test:arch": "vitest run --config vitest.arch.config.ts",
    "test:arch:report": "ARCH_REPORT=1 vitest run --config vitest.arch.config.ts",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node --env-file=.env.test node_modules/.bin/vite build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:antlr": "cd src/lib/editor/grammar && antlr-ng -v -l -Dlanguage=TypeScript -o ../generated SqlBase.g4 && node patch-generated.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/lib/server/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.6.0",
    "@iconify-json/lsicon": "^1.2.5",
    "@iconify-json/material-icon-theme": "^1.2.72",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/vscode-icons": "^1.2.91",
    "@inlang/paraglide-js": "^2.29.0",
    "@playwright/test": "1.61.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/enhanced-img": "^0.11.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "antlr-ng": "^1.0.10",
    "archunit": "^2.5.4",
    "daisyui": "^5.7.50",
    "devalue": "^5.9.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "knip": "^6.42.0",
    "oauth2-mock-server": "^9.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "sveltekit-superforms": "^2.31.0",
    "tailwindcss": "^4.2.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vitest-browser-svelte": "^2.2.1",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/lib-storage": "^3.1152.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@eslint-community/regexpp": "^4.12.2",
    "@internationalized/date": "^3.12.4",
    "@smithy/node-http-handler": "^4.12.1",
    "adm-zip": "^0.6.1",
    "antlr4-c3": "^3.4.4",
    "antlr4ng": "^3.0.16",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hyparquet": "^1.31.5",
    "hyparquet-compressors": "^1.1.2",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pretty-bytes": "^7.2.0",
    "prom-client": "^15.1.3",
    "tar-stream": "^3.2.2",
    "undici": "^7.30.1"
  },
  "//overrides": {
    "@sveltejs/kit > cookie": "SvelteKit requests ^0.6.0, which excludes the cookie validation security fix in 0.7.x. Remove when SvelteKit requires a patched version.",
    "monaco-editor > dompurify": "Monaco pins DOMPurify to 3.4.15. Use ^3.4.17 for subsequent sanitisation security fixes; remove when Monaco requires an equally patched or newer version."
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    },
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}
