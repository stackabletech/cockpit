{
  "name": "@stackable/stackable-cockpit",
  "private": true,
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "prepare": "svelte-kit sync || echo '' && npm run generate:antlr",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write --ignore-path .prettierignore .",
    "lint": "prettier --check --ignore-path .prettierignore . && eslint .",
    "lint:fix": "prettier --write --ignore-path .prettierignore . && eslint . --fix",
    "test:unit": "vitest run",
    "test:e2e": "node --env-file=.env.test node_modules/.bin/vite build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate:antlr": "cd src/lib/editor/grammar && antlr-ng -v -l -Dlanguage=TypeScript -o ../generated SqlBase.g4 && node patch-generated.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:run": "tsx src/lib/server/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@faker-js/faker": "^10.4.0",
    "@iconify-json/material-symbols": "^1.2.74",
    "@inlang/paraglide-js": "^2.12.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/adapter-node": "^5.5.3",
    "@sveltejs/kit": "^2.53.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/node": "^24",
    "@types/pg": "^8.20.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "antlr-ng": "^1.0.10",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-better-tailwindcss": "^4.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^16.5.0",
    "oauth2-mock-server": "^8.2.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.53.3",
    "svelte-check": "^4.4.3",
    "sveltekit-superforms": "^2.30.0",
    "tailwindcss": "^4.2.1",
    "testcontainers": "^12.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@better-auth/drizzle-adapter": "^1.6.19",
    "@internationalized/date": "^3.11.0",
    "antlr4-c3": "^3.4.4",
    "antlr4ng": "^3.0.16",
    "better-auth": "^1.6.19",
    "drizzle-orm": "^0.45.2",
    "hyparquet": "^1.25.8",
    "hyparquet-compressors": "^1.1.1",
    "monaco-editor": "^0.55.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pretty-bytes": "^7.1.0",
    "prom-client": "^15.1.3",
    "undici": "^7.24.4"
  }
}
